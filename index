          </defs>
          <path d="M14 1C7.37 1 2 6.37 2 13c0 8.5 12 21 12 21s12-12.5 12-21c0-6.63-5.37-12-12-12z"
                fill="#b91c1c" stroke="#450a0a" stroke-width="1.3" filter="url(#pin-shadow)"/>
          <circle cx="14" cy="13" r="4.8" fill="#fef3c7"/>
        </svg>
      `;
      return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg.trim());
    }

    function createSailingShipSVG() {
      var svg = `
        <svg xmlns="http://www.w3.org/2000/svg" width="46" height="46" viewBox="0 0 48 48">
          <defs>
            <filter id="ship-shadow" x="-25%" y="-25%" width="150%" height="150%">
              <feDropShadow dx="0" dy="2" stdDeviation="2" flood-color="#2b190a" flood-opacity="0.65"/>
            </filter>
          </defs>
          <g filter="url(#ship-shadow)">
            <path d="M10 38 Q17 41 24 38 Q31 41 38 38" fill="none" stroke="#5c3d1e" stroke-width="1.6" stroke-linecap="round"/>
            <line x1="23" y1="7" x2="23" y2="31" stroke="#3e2712" stroke-width="2" stroke-linecap="round"/>
            <line x1="32" y1="12" x2="32" y2="31" stroke="#3e2712" stroke-width="1.6" stroke-linecap="round"/>
            <path d="M23 7 L15 9.5 L23 12 Z" fill="#991b1b"/>
            <path d="M23 12 C16 14 14 21 15 27 C19 26 21 26 23 27 Z" fill="#fffbeb" stroke="#5c3d1e" stroke-width="1.3"/>
            <path d="M23 12 C28 14 29 21 28 27 C26 26 24 26 23 27 Z" fill="#fef3c7" stroke="#5c3d1e" stroke-width="1.3"/>
            <path d="M32 14 C37 17 38 22 37 27 C35 26 33 26 32 27 Z" fill="#fffbeb" stroke="#5c3d1e" stroke-width="1.2"/>
            <path d="M8 29 L40 29 L36 36 C28 37.5 20 37.5 12 36 Z" fill="#78350f" stroke="#2b190a" stroke-width="1.4" stroke-linejoin="round"/>
            <line x1="10" y1="32" x2="38" y2="32" stroke="#f59e0b" stroke-width="1.2"/>
          </g>
        </svg>
      `;
      return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg.trim());
    }

    function createCurvedArc(startCoords, endCoords, numPoints) {
      var start = turf.point(startCoords);
      var end = turf.point(endCoords);
      var dist = turf.distance(start, end);

      if (dist < 15) {
        var shortSteps = [];
        for (var s = 0; s <= numPoints; s++) {
          var t = s / numPoints;
          shortSteps.push([
            startCoords[0] + (endCoords[0] - startCoords[0]) * t,
            startCoords[1] + (endCoords[1] - startCoords[1]) * t
          ]);
        }
        return shortSteps;
      }

      var mid = turf.midpoint(start, end);
      var bearing = turf.bearing(start, end);
      var arcOffset = Math.min(dist * 0.16, 180);
      var controlPt = turf.destination(mid, arcOffset, bearing - 90);

      var line = turf.lineString([
        startCoords,
        controlPt.geometry.coordinates,
        endCoords
      ]);

      var curved = turf.bezierSpline(line, { resolution: 6000, sharpness: 0.85 });
      var totalLen = turf.length(curved);
      var sampled = [];

      for (var i = 0; i <= numPoints; i++) {
        var pt = turf.along(curved, (totalLen * i) / numPoints);
        sampled.push(pt.geometry.coordinates);
      }
      return sampled;
    }

    function filterSmallPolygons(geom, minAreaMeters) {
      if (geom.type === 'Polygon') {
        return turf.area(turf.polygon(geom.coordinates)) >= minAreaMeters ? geom : null;
      }
      if (geom.type === 'MultiPolygon') {
        var valid = geom.coordinates.filter(function(c) {
          return turf.area(turf.polygon(c)) >= minAreaMeters;
        });
        if (valid.length === 0) return null;
        return valid.length === 1
          ? { type: 'Polygon', coordinates: valid[0] }
          : { type: 'MultiPolygon', coordinates: valid };
      }
      return geom;
    }

    function drawNauticalGraticule() {
      var lines = [];
      for (var lng = 90; lng <= 145; lng += 5) {
        lines.push({ type: "Feature", geometry: { type: "LineString", coordinates: [[lng, -15], [lng, 12]] } });
      }
      for (var lat = -15; lat <= 12; lat += 5) {
        lines.push({ type: "Feature", geometry: { type: "LineString", coordinates: [[90, lat], [145, lat]] } });
      }
      map.addSource('graticule', { type: 'geojson', data: { type: "FeatureCollection", features: lines } });
      map.addLayer({
        id: 'graticule-layer',
        type: 'line',
        source: 'graticule',
        paint: {
          'line-color': '#5c3d1e',
          'line-width': 0.7,
          'line-opacity': 0.22,
          'line-dasharray': [4, 4]
        }
      });
    }

    // ========================================================
    // 6. ENGINE ANIMASI PELAYARAN KAPAL & FINALE KONSTELASI KOTA
    // ========================================================
    var precomputedArcs = [];
    for (var i = 0; i < journeySteps.length - 1; i++) {
      precomputedArcs.push(
        createCurvedArc(journeySteps[i].coords, journeySteps[i + 1].coords, 45)
      );
    }

    var animState = {
      stepIdx: 0,
      subIdx: 0,
      dwellFrames: 0,
      paused: false,
      finished: false,
      completedArcs: [],
      droppedPins: {},
      shipFlip: -1
    };

    function updateMapLayers(shipCoords, activeArcSlice, flipDir) {
      var allArcFeatures = animState.completedArcs.slice();
      if (activeArcSlice && activeArcSlice.length >= 2) {
        allArcFeatures.push({
          type: "Feature",
          geometry: { type: "LineString", coordinates: activeArcSlice }
        });
      }
      if (map.getSource('route-arcs')) {
        map.getSource('route-arcs').setData({
          type: "FeatureCollection",
          features: allArcFeatures
        });
      }

      var pinFeatures = Object.keys(animState.droppedPins).map(function(key) {
        var p = animState.droppedPins[key];
        return {
          type: "Feature",
          geometry: { type: "Point", coordinates: p.coords },
          properties: { city: p.city }
        };
      });
      if (map.getSource('dropped-pins')) {
        map.getSource('dropped-pins').setData({
          type: "FeatureCollection",
          features: pinFeatures
        });
      }

      if (map.getSource('traveler-icon')) {
        map.getSource('traveler-icon').setData({
          type: "FeatureCollection",
          features: [{
            type: "Feature",
            geometry: { type: "Point", coordinates: shipCoords },
            properties: {
              shipImage: flipDir < 0 ? 'ship-left' : 'ship-right'
            }
          }]
        });
      }
    }

    var lastFrameTime = 0;
    function animateJourney(timestamp) {
      requestAnimationFrame(animateJourney);

      if (animState.paused || animState.finished) return;
      if (timestamp - lastFrameTime < 28) return;
      lastFrameTime = timestamp;

      var currentStop = journeySteps[animState.stepIdx];

      // FASE AKHIR: TIBA DI SINGAPURA 2026 -> TAHUN HILANG -> MUNCUL SEMUA NAMA KOTA DI PERAIRAN
      if (animState.stepIdx >= journeySteps.length - 1) {
        if (animState.dwellFrames === 0) {
          setDigitalYear(currentStop.year, false);
          setYearGlow(true);
          showCityWatermarkInOpenSea(currentStop);
        }
        if (animState.dwellFrames < 36) {
          animState.dwellFrames++;
          return;
        }

        animState.droppedPins[currentStop.pinId] = {
          city: currentStop.city,
          coords: currentStop.coords
        };
        updateMapLayers(currentStop.coords, null, animState.shipFlip);

        setYearGlow(false);
        document.getElementById('year-foreground').classList.add('fade-out');
        showFinaleCityCloud();

        animState.finished = true;
        return;
      }

      // 1. FASE BERLABUH DI KOTA: Angka tahun menyala & nama kota muncul di lautan bebas dekat wilayahnya
      if (animState.subIdx === 0 && animState.dwellFrames < 28) {
        if (animState.dwellFrames === 0) {
          setDigitalYear(currentStop.year, false);
          setYearGlow(true);
          showCityWatermarkInOpenSea(currentStop);
        }
        animState.dwellFrames++;
        updateMapLayers(currentStop.coords, null, animState.shipFlip);
        return;
      }

      // 2. FASE BERLAYAR MENUJU KOTA BERIKUTNYA:
      var arcPoints = precomputedArcs[animState.stepIdx];
      var nextStop = journeySteps[animState.stepIdx + 1];

      if (animState.subIdx === 1) {
        setYearGlow(false);
        hideCityWatermark();
        animState.droppedPins[currentStop.pinId] = {
          city: currentStop.city,
          coords: currentStop.coords
        };
        animState.shipFlip = (nextStop.coords[0] < currentStop.coords[0]) ? -1 : 1;
      }

      var progressRatio = animState.subIdx / (arcPoints.length - 1);
      var interpolatedYear = Math.round(currentStop.year + (nextStop.year - currentStop.year) * progressRatio);
      if (interpolatedYear !== currentDisplayedYear) {
        setDigitalYear(interpolatedYear, false);
      }

      var currentPos = arcPoints[animState.subIdx];
      var sliceSoFar = arcPoints.slice(0, animState.subIdx + 1);
      updateMapLayers(currentPos, sliceSoFar, animState.shipFlip);

      animState.subIdx++;

      if (animState.subIdx >= arcPoints.length) {
        animState.completedArcs.push({
          type: "Feature",
          geometry: { type: "LineString", coordinates: arcPoints }
        });
        animState.stepIdx++;
        animState.subIdx = 0;
        animState.dwellFrames = 0;
      }
    }

    function togglePause() {
      animState.paused = !animState.paused;
      document.getElementById('btn-pause').innerText = animState.paused ? "▶ Lanjut" : "⏸ Jeda";
    }

    function restartJourney() {
      animState.stepIdx = 0;
      animState.subIdx = 0;
      animState.dwellFrames = 0;
      animState.paused = false;
      animState.finished = false;
      animState.completedArcs = [];
      animState.droppedPins = {};
      animState.shipFlip = -1;
      document.getElementById('btn-pause').innerText = "⏸ Jeda";

      document.getElementById('city-bg-layer').innerHTML = '';
      var yearFg = document.getElementById('year-foreground');
      yearFg.classList.remove('fade-out');

      setDigitalYear(1993, false);
      setYearGlow(true);
      showCityWatermarkInOpenSea(journeySteps[0]);
      updateMapLayers(journeySteps[0].coords, null, animState.shipFlip);
    }

    // ========================================================
    // 7. MUAT LAYER PETA & MULAI ANIMASI
    // ========================================================
    map.on('load', function() {
      drawNauticalGraticule();

      fetch('https://raw.githubusercontent.com/TheMaggieSimpson/IndonesiaGeoJSON/master/provinsi.json')
        .then(function(res) { return res.json(); })
        .then(function(data) {
          var cleanFeatures = [];
          data.features.forEach(function(feat) {
            var cleaned = filterSmallPolygons(feat.geometry, 800000000);
            if (cleaned) {
              feat.geometry = cleaned;
              cleanFeatures.push(feat);
            }
          });

          map.addSource('indonesia-2d', {
            type: 'geojson',
            data: { type: "FeatureCollection", features: cleanFeatures }
          });

          map.addLayer({
            id: 'indonesia-land-fill',
            type: 'fill',
            source: 'indonesia-2d',
            paint: {
              'fill-color': '#dec397',
              'fill-opacity': 0.96
            }
          });

          map.addLayer({
            id: 'indonesia-land-outline',
            type: 'line',
            source: 'indonesia-2d',
            paint: {
              'line-color': '#5c3d1e',
              'line-width': 1.0,
              'line-opacity': 0.85
            }
          });

          map.addSource('route-arcs', {
            type: 'geojson',
            data: { type: "FeatureCollection", features: [] }
          });

          map.addLayer({
            id: 'route-arcs-shadow',
            type: 'line',
            source: 'route-arcs',
            layout: { 'line-cap': 'round', 'line-join': 'round' },
            paint: {
              'line-color': '#f59e0b',
              'line-width': 4.5,
              'line-opacity': 0.25,
              'line-blur': 2
            }
          });

          map.addLayer({
            id: 'route-arcs-dashed',
            type: 'line',
            source: 'route-arcs',
            layout: { 'line-cap': 'round', 'line-join': 'round' },
            paint: {
              'line-color': '#991b1b',
              'line-width': 2.2,
              'line-opacity': 0.92,
              'line-dasharray': [2.5, 2.5]
            }
          });

          var pinImg = new Image(26, 34);
          var shipImgRight = new Image(46, 46);
          var loadedCount = 0;

          function onAllAssetsLoaded() {
            loadedCount++;
            if (loadedCount < 2) return;

            map.addImage('red-iconic-pin', pinImg);
            map.addImage('ship-right', shipImgRight);

            var flipCanvas = document.createElement('canvas');
            flipCanvas.width = 46;
            flipCanvas.height = 46;
            var ctx = flipCanvas.getContext('2d');
            ctx.translate(46, 0);
            ctx.scale(-1, 1);
            ctx.drawImage(shipImgRight, 0, 0);
            var flippedData = ctx.getImageData(0, 0, 46, 46);
            map.addImage('ship-left', { width: 46, height: 46, data: flippedData.data });

            map.addSource('dropped-pins', {
              type: 'geojson',
              data: { type: "FeatureCollection", features: [] }
            });

            map.addLayer({
              id: 'dropped-pins-layer',
              type: 'symbol',
              source: 'dropped-pins',
              layout: {
                'icon-image': 'red-iconic-pin',
                'icon-size': 0.85,
                'icon-anchor': 'bottom',
                'icon-allow-overlap': true,
                'icon-ignore-placement': true
              }
            });

            map.addSource('traveler-icon', {
              type: 'geojson',
              data: {
                type: "FeatureCollection",
                features: [{
                  type: "Feature",
                  geometry: { type: "Point", coordinates: journeySteps[0].coords },
                  properties: { shipImage: 'ship-left' }
                }]
              }
            });

            map.addLayer({
              id: 'traveler-icon-layer',
              type: 'symbol',
              source: 'traveler-icon',
              layout: {
                'icon-image': ['get', 'shipImage'],
                'icon-size': 0.95,
                'icon-anchor': 'center',
                'icon-allow-overlap': true,
                'icon-ignore-placement': true
              }
            });

            requestAnimationFrame(animateJourney);
          }

          pinImg.onload = onAllAssetsLoaded;
          shipImgRight.onload = onAllAssetsLoaded;
          pinImg.src = createRedPinSVG();
          shipImgRight.src = createSailingShipSVG();
        });
    });
  </script>
