    var activeCityEl = null;

    // Munculkan nama kota ukuran besar di LAUTAN BEBAS terdekat & pastikan tidak keluar frame
    function showCityWatermarkInOpenSea(stepObj) {
      var container = document.getElementById('city-bg-layer');

      if (activeCityEl) {
        var oldEl = activeCityEl;
        oldEl.classList.remove('active');
        setTimeout(function() {
          if (oldEl && oldEl.parentNode) oldEl.parentNode.removeChild(oldEl);
        }, 480);
      }

      var anchorCoords = stepObj.seaAnchor || stepObj.coords;
      var projected = map.project(anchorCoords);

      var jitterX = (Math.random() - 0.5) * 22;
      var jitterY = (Math.random() - 0.5) * 16;

      var targetX = projected.x + jitterX;
      var targetY = projected.y + jitterY;

      var el = document.createElement('div');
      el.className = 'bg-city-word';
      el.innerText = stepObj.city;
      el.style.left = targetX + 'px';
      el.style.top = targetY + 'px';

      container.appendChild(el);
      activeCityEl = el;

      // Ukur lebar aktual teks agar otomatis terkunci aman di dalam bingkai peta
      var rect = el.getBoundingClientRect();
      var halfW = (rect.width / 2) + 32;
      var halfH = (rect.height / 2) + 32;

      var clampedX = Math.max(halfW, Math.min(window.innerWidth - halfW, targetX));
      var clampedY = Math.max(halfH, Math.min(window.innerHeight - halfH, targetY));

      el.style.left = clampedX + 'px';
      el.style.top = clampedY + 'px';

      requestAnimationFrame(function() {
        requestAnimationFrame(function() {
          el.classList.add('active');
        });
      });
    }

    function hideCityWatermark() {
