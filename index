       ======================================================== */
    .city-bg-layer {
      position: absolute;
      inset: 0;
      z-index: 1; /* Berada di BAWAH kanvas pulau-pulau Indonesia (z-index: 2) */
      pointer-events: none;
      overflow: hidden;
      user-select: none;
