    var DIGIT_HEIGHT = 600;

    function initDigitalYearReels() {
      for (var r = 0; r < 4; r++) {
        var reel = document.getElementById('reel-' + r);
        var html = '';
        for (var d = 0; d <= 9; d++) {
          html += '<div class="digit-item">' + d + '</div>';
        }
        reel.innerHTML = html;
      }
      setDigitalYear(1993, true);
    }

    var currentDisplayedYear = 1993;
    function setDigitalYear(yearNum, instant) {
      var clampedYear = Math.round(yearNum);
      var yearStr = String(clampedYear).padStart(4, '0');

      for (var r = 0; r < 4; r++) {
        var digit = parseInt(yearStr[r], 10);
        var reel = document.getElementById('reel-' + r);
        reel.style.transition = instant
          ? 'none'
          : 'transform 0.35s cubic-bezier(0.22, 1, 0.36, 1)';
        reel.style.transform = 'translateY(-' + (digit * DIGIT_HEIGHT) + 'px)';
      }
      currentDisplayedYear = clampedYear;
    }

    function setYearGlow(isLit) {
      var foreground = document.getElementById('year-foreground');
      if (isLit) {
        foreground.classList.add('arrived-glow');
      } else {
