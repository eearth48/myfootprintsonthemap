      opacity: 0;
      transform: translate(-50%, -50%) scale(0.92);
      transition: opacity 0.5s ease, transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .bg-city-word.active {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }

