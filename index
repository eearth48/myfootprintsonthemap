        el.innerText = item.name;
        el.style.left = item.left + '%';
        el.style.top = item.top + '%';
        el.style.fontSize = item.size;
        container.appendChild(el);

        setTimeout(function() {
          el.classList.add('visible');
        }, 120 + index * 48);
      });
    }

